# Public API origin used by the deployed widget.
VITE_ASSISTANT_API_URL=https://zit-website-assistant.onrender.com
# Optional for the first Vercel deploy; the school-site loader can set this.
VITE_ASSISTANT_WIDGET_URL=
# Replace these example school-site origins before production use.
VITE_PARENT_ORIGINS=https://your-school.example,https://www.your-school.example,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Leave blank to keep Turnstile disabled.
VITE_TURNSTILE_SITE_KEY=
# Optional public links shown in the widget.
VITE_PRIVACY_URL=
VITE_CONTACT_URL=
