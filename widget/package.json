{
  "name": "zit-assistant-widget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/build.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:urls": "vitest run src/components/UrlRendering.test.tsx",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "stylecheck": "tsx scripts/check-styles.ts",
    "sizecheck": "tsx scripts/check-size.ts",
    "mockcheck": "tsx scripts/check-mock-absence.ts",
    "secretcheck": "tsx scripts/check-secrets.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "22.19.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "jsdom": "25.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
