ENV=dev
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
DATABASE_URL_DIRECT=
DATABASE_SSL_ROOT_CERT=
DB_POOL_SIZE=8
WRITER_QUEUE_MAX=5000
WRITER_BATCH_ROWS=100
WRITER_FLUSH_SECONDS=1
SESSION_PEPPER=
ADMIN_BOOTSTRAP_KEY_HASH=
ADMIN_DOCS_USERNAME=
ADMIN_DOCS_PASSWORD=
PUBLIC_DOCS_ENABLED=false
WIDGET_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_IP_ALLOWLIST=
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=INFO
GIT_SHA=local
SENTRY_DSN=placeholder
OTLP_ENDPOINT=
